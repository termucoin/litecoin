[Desktop Entry]
Version=1.0
Name=Teranocoin Core
Comment=Connect to the Teranocoin P2P Network
Comment[de]=Verbindung mit dem Teranocoin Peer-to-Peer-Netzwerk herstellen
Comment[es]=Conectar a la red P2P de Teranocoin
Comment[fr]=Se connecter au réseau pair à pair Teranocoin
GenericName=Cryptocurrency Wallet
Exec=teranocoin-qt %u
Terminal=false
Type=Application
Icon=teranocoin128
MimeType=x-scheme-handler/teranocoin;
Categories=Office;Finance;Network;
Keywords=teranocoin;crypto;cryptocurrency;wallet;blockchain;
StartupNotify=true
StartupWMClass=Teranocoin-qt
